# PostgreSQL / Supabase
# Use Supabase transaction-mode pooler (port 6543) for DATABASE_URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Use Supabase session-mode pooler (port 5432) for DIRECT_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Shopify
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_APP_URL=""
SCOPES=""
